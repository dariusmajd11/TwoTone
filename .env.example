# Copy to .env.local and fill in. Every value is optional — TwoTone falls back to
# local, on-disk implementations for anything you leave blank, so the app runs
# end to end before an AWS account exists.

# --- Identification -----------------------------------------------------------
# Without this, /api/identify returns a fixed sample garment so the UI is
# developable. With it, photos go to Claude for real identification.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# --- AWS ----------------------------------------------------------------------
# Each service switches from local to AWS independently, and only once BOTH the
# credentials below AND that service's own variables are set.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 — uploaded garment photos
TWOTONE_S3_BUCKET=

# DynamoDB — users table needs a GSI named `email-index` on `email`.
# History table must be keyed (userId HASH, createdAt RANGE).
TWOTONE_DDB_USERS_TABLE=
TWOTONE_DDB_HISTORY_TABLE=

# Cognito — the user pool must allow the USER_PASSWORD_AUTH flow.
# Leave the secret blank if the app client was created without one.
TWOTONE_COGNITO_USER_POOL_ID=
TWOTONE_COGNITO_CLIENT_ID=
TWOTONE_COGNITO_CLIENT_SECRET=

# --- Sessions -----------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
TWOTONE_SESSION_SECRET=
